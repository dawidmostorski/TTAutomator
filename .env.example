# Required by the current bot, including when using a static comment list.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: select a device when running diagnostic scripts from the terminal.
# Get its ID using: adb devices
APPIUM_DEVICE_ID=

# Optional: Android screen unlock PIN. Leave empty if not needed.
DEVICE_PIN=

# Optional probabilities for direct bot.js runs (GUI supplies its own values).
LIKE_PROBABILITY=0
FOLLOW_PROBABILITY=0
COMMENT_PROBABILITY=0
REPLY_PROBABILITY=0
